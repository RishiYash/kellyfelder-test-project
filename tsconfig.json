{
    "compilerOptions": {
      "target": "ES2022",
      "lib": ["ESNext"],
      "module": "ESNext",
      "moduleResolution": "bundler",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "noEmit": true,
      "types": ["node"]
    },
    "include": ["tests", "pages", "fixtures", "test-data", "playwright.config.ts"]
  }